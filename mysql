
#### Creating Mysql helm chart:
1. for creating row chart
```bash
helm create sql
```
2. changes in values.yaml  
- image:
  - repository: `mysql`
  - tag: `"5.6"`  
- service:
  - type: `ClusterIP`
  - port: `3306`
3. Add whole env section in values.yaml
```bash
env:
  passwd: rootPasswd
  user: admin
  db: mydb
  userPasswd: adminPasswd
```


env:
            - name: MYSQL_ROOT_PASSWORD
              value: passwd
            - name: MYSQL_DATABASE
              value: mydb
            - name: MYSQL_DATABASE
              value: admin
            - name: MYSQL_PASSWORD
              value: passwd
  
env:
            - name: MYSQL_ROOT_PASSWORD
              value: "{{ .Values.env.passwd }}"
            - name: MYSQL_DATABASE
              value: "{{ .Values.env.db }}"
            - name: MYSQL_USER
              value: "{{ .Values.env.user }}"
            - name: MYSQL_PASSWORD
              value: "{{ .Values.env.userPasswd }}"
env:
            - name: WORDPRESS_DB_HOST
              value: {{ .Values.env.passwd.host }}
            - name: WORDPRESS_DB_NAME
              value: {{ .Values.env.db }}
            - name: WORDPRESS_DB_USER
              value: {{ .Values.env.user }}
            - name: WORDPRESS_DB_PASSWORD
              value: {{ .Values.env.userPasswd }}
